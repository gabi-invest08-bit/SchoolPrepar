{% extends 'base.html.twig' %}

{% block title %}Nos Filières - {{ filieres|length }} disponibles{% endblock %}

{% block body %}
<section class="section main-banner" style=\"background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{{ asset('assets/images/courses-bg.jpg') }}');\">
  <div class=\"video-overlay header-text\">
    <div class=\"caption\">
      <h6>SchoolPrepar</h6>
      <h2><em>{{ filieres|length }}</em> Filières</h2>
      <div class=\"main-button\">
        <a href=\"{{ path('app_filiere_control_new') }}\" class=\"btn btn-primary\">Nouvelle Filière</a>
      </div>
    </div>
  </div>
</section>

<section class=\"section courses\">
  <div class=\"container-fluid\">
    <div class=\"row\">
      <div class=\"col-md-12\">
        <div class=\"section-heading\">
          <h2>Découvrez nos Filières</h2>
        </div>
      </div>
      {% if filieres|length > 0 %}
      <div class=\"owl-carousel owl-theme\">
        {% for filiere in filieres %}
        <div class=\"item\">
          <div class=\"down-content full-card\">
            <h4 class=\"big-title\">{{ filiere.nom }}</h4>
            <p class=\"description\">{{ filiere.description|slice(0, 150) ~ '...' }}</p>
            <span class=\"etabs-count\">{{ filiere.etablissements|length }} établissement(s)</span>
            <div class=\"text-button-pay\">
              <a href=\"{{ path('app_filiere_control_show', {'id': filiere.id}) }}\">Détails</a>
              <a href=\"{{ path('app_filiere_control_edit', {'id': filiere.id}) }}\" class=\"btn btn-sm btn-warning ms-2\">Éditer</a>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class=\"col-md-12 text-center py-5\">
        <h3>Aucune filière disponible</h3>
        <a href=\"{{ path('app_filiere_control_new') }}\" class=\"btn btn-primary\">Créer la première</a>
      </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
.full-card { padding: 30px; background: white; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); min-height: 300px; }
.big-title { font-size: 2em; margin-bottom: 15px; color: #333; }
.description { font-size: 1.1em; color: #666; margin-bottom: 10px; line-height: 1.5; }
.etabs-count { color: #28a745; font-weight: bold; background: #d4edda; padding: 5px 12px; border-radius: 20px; display: inline-block; }
</style>

<link rel=\"stylesheet\" href=\"{{ asset('assets/css/owl.css') }}\">
<script src=\"{{ asset('assets/js/owl-carousel.js') }}\"></script>
<script>
$(document).ready(function(){
  $(\".owl-carousel\").owlCarousel({
    items: 3,
    loop: true,
    margin: 10,
    nav: true
  });
});
</script>
{% endblock %}
